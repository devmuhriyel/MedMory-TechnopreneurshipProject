<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="mainContainer" prefHeight="768.0" prefWidth="1366.0" style="-fx-background-color: #e6f0e6;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.Client.ClientSettingsController">

    <!-- Sidebar -->
    <left>
        <VBox alignment="TOP_CENTER" prefWidth="170.0" spacing="15.0" style="-fx-background-color: #00BF63;">
            <padding>
                <Insets bottom="20.0" left="10.0" right="10.0" top="20.0" />
            </padding>

            <ImageView fitHeight="45.0" fitWidth="45.0">
                <image>
                    <Image url="@../images/logoApp.png" />
                </image>
            </ImageView>

            <VBox alignment="CENTER" spacing="10.0">
            <Button fx:id="casesButton1" contentDisplay="LEFT" onAction="#handleNavigation" prefWidth="150.0" style="-fx-background-color: #008060; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="Home">
               <graphic>
                  <Label style="-fx-font-size: 20px;" textFill="WHITE" />
               </graphic>
            </Button>

                <Button fx:id="accountButton" contentDisplay="LEFT" onAction="#handleNavigation" prefWidth="150.0" style="-fx-background-color: #008060; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="Account">
                    <graphic>
                        <Label style="-fx-font-size: 20px;" text="👤" textFill="WHITE" />
                    </graphic>
                </Button>
            <Button fx:id="casesButton2" contentDisplay="LEFT" onAction="#handleNavigation" prefWidth="150.0" style="-fx-background-color: #008060; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="Medical Record">
               <graphic>
                  <Label style="-fx-font-size: 20px;" text="💼" textFill="WHITE" />
               </graphic>
            </Button>

            </VBox>

            <VBox VBox.vgrow="ALWAYS" />

            <Button fx:id="settingsButton" contentDisplay="LEFT" onAction="#handleNavigation" prefWidth="150.0" style="-fx-background-color: #b0e0ff; -fx-background-radius: 5; -fx-font-weight: bold; -fx-border-color: #2090ff; -fx-text-fill: #0050c0; -fx-cursor: hand;" text="Settings">
                <graphic>
                    <Label style="-fx-font-size: 20px;" text="⚙" textFill="#0050c0" />
                </graphic>
            </Button>

        </VBox>
    </left>

    <!-- Main Settings Content -->
    <center>
        <VBox spacing="20.0" style="-fx-background-color: #e6f0e6;">
            <padding>
                <Insets bottom="30" left="30" right="30" top="30" />
            </padding>

            <Label style="-fx-font-size: 30px; -fx-font-weight: bold;" text="Doctor Settings" />

            <!-- Notifications Section -->
            <VBox spacing="10.0" style="-fx-background-color: WHITE; -fx-padding: 20; -fx-background-radius: 10;">
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Notification Preferences" />
                <CheckBox fx:id="emailNotifCheck" selected="true" text="Email Notifications" />
                <CheckBox fx:id="smsNotifCheck" text="SMS Notifications" />
                <CheckBox fx:id="pushNotifCheck" selected="true" text="Push Notifications" />
            </VBox>

            <!-- Application Preferences Section -->
            <VBox spacing="10.0" style="-fx-background-color: WHITE; -fx-padding: 20; -fx-background-radius: 10;">
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Application Preferences" />
                <CheckBox fx:id="darkModeCheck" text="Enable Dark Mode" />
                <CheckBox fx:id="autoUpdateCheck" selected="true" text="Enable Automatic Updates" />
            </VBox>

            <!-- Buttons -->
            <HBox alignment="CENTER_RIGHT" spacing="20">
                <Button fx:id="logoutButton" style="-fx-background-color: #e57373; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 10 20 10 20; -fx-cursor: hand;" text="Logout" />
                <Button fx:id="saveButton" style="-fx-background-color: #00BF63; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 10 20 10 20; -fx-cursor: hand;" text="Save Changes" />
            </HBox>

        </VBox>
    </center>

</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="768.0" prefWidth="1366.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.Admin.AddUserController">

    <children>

        <!-- Sidebar -->
        <Rectangle fill="#00A86B" height="768.0" width="220.0">
            <effect>
                <DropShadow color="#00000033" offsetX="2" radius="10" />
            </effect>
        </Rectangle>

        <Label layoutX="40" layoutY="35" text="Admin" textFill="WHITE">
            <font>
                <Font name="System Bold" size="36" />
            </font>
        </Label>

        <VBox layoutX="20" layoutY="120" spacing="15" />

        <!-- Main Content Card -->
        <AnchorPane layoutX="250.0" layoutY="40.0" prefHeight="680" prefWidth="1050" style="                         -fx-background-color: white;                         -fx-background-radius: 15;                     ">
            <effect>
                <DropShadow color="#00000022" radius="15" />
            </effect>

            <children>

                <Label layoutX="30" layoutY="25" text="Add User" textFill="#00A86B">
                    <font>
                        <Font name="System Bold" size="32" />
                    </font>
                </Label>
                <Button fx:id="editButton" layoutX="262.0" layoutY="254.0" onAction="#handleCreateUser" prefWidth="200" style="-fx-background-color: #6AC920; -fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-background-radius: 12;" text="Add User" />
                <VBox layoutX="30.0" layoutY="86.0" prefHeight="72.0" prefWidth="308.0" spacing="5">
                    <children>
                        <Label text="Name:" />
                        <TextField fx:id="nameField" />
                    </children>
                </VBox>
                <Label layoutX="380.0" layoutY="86.0" text="Role:" />

                <ComboBox fx:id="roleBox" layoutX="380.0" layoutY="110.0" prefWidth="308.0" />

                <Label layoutX="30.0" layoutY="158.0" text="Password:" />
                <TextField fx:id="passwordField" layoutX="30.0" layoutY="182.0" prefHeight="25.0" prefWidth="308.0" />
                <Button fx:id="backButton" layoutX="38.0" layoutY="254.0" onAction="#handleNavigation" prefWidth="200" style="-fx-background-color: A6AEBA; -fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-background-radius: 12;" text="Back" />

            </children>
        </AnchorPane>

    </children>
</AnchorPane>

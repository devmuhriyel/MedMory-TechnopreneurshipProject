<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="mainContainer" prefHeight="768.0" prefWidth="1366.0"
            xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controller.Doctor.HistoryController">

    <center>
        <VBox alignment="TOP_LEFT" spacing="15.0" style="-fx-background-color: #e6f0e6;" BorderPane.alignment="TOP_LEFT">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- Header -->
            <Label text="Patient History" style="-fx-font-size: 24px; -fx-font-weight: bold;" />

            <!-- Search Field -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" promptText="Search treatment/diagnosis" HBox.hgrow="ALWAYS"/>
            </HBox>

            <!-- TableView for Cases -->
            <TableView fx:id="casesTable" prefHeight="500">
                <columns>
                    <TableColumn fx:id="caseDateCol" text="Case Date" prefWidth="150"/>
                    <TableColumn fx:id="treatmentCol" text="Treatment" prefWidth="200"/>
                    <TableColumn fx:id="patientCol" text="Patient" prefWidth="200"/>
                    <TableColumn fx:id="diagnosisCol" text="Diagnosis" prefWidth="250"/>
                    <TableColumn fx:id="completionDateCol" text="Completion Date" prefWidth="150"/>
                </columns>
            </TableView>

            <Button text="Return" fx:id="returnButton" onAction="#handleReturn" prefWidth="120"/>
        </VBox>
    </center>
</BorderPane>

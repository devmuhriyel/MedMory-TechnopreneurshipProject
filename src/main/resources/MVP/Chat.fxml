<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="mainContainer" prefHeight="768.0" prefWidth="1366.0" style="-fx-background-color: #e6f0e6;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1"   fx:controller="Controller.Doctor.ChatController">

    <left>
        <VBox alignment="TOP_CENTER" prefWidth="170.0" spacing="15.0" style="-fx-background-color: #00BF63;" BorderPane.alignment="TOP_LEFT">
            <padding>
                <Insets bottom="20.0" left="10.0" right="10.0" top="20.0" />
            </padding>
            <ImageView fitHeight="45.0" fitWidth="45.0">
                <image>
                    <Image url="@../images/logoApp.png" />
                </image>
            </ImageView>

            <VBox alignment="CENTER" spacing="10.0">

                <Button fx:id="accountButton" contentDisplay="LEFT" onAction="#handleNavigation" prefWidth="150.0" style="-fx-background-color: #008060; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="Account">
                    <graphic>
                        <Label style="-fx-font-size: 20px;" text="👤" textFill="WHITE" />
                    </graphic>
                </Button>

                <Button fx:id="casesButton" contentDisplay="LEFT" onAction="#handleNavigation" prefWidth="150.0" style="-fx-background-color: #008060; -fx-background-radius: 5; -fx-font-weight: bold; -fx-border-color: #2090ff; -fx-text-fill: WHITE; -fx-cursor: hand;" text="Cases">
                    <graphic>
                        <Label style="-fx-font-size: 20px;" text="💼" textFill="WHITE" />
                    </graphic>
                </Button>

                <Button fx:id="calendarButton" contentDisplay="LEFT" onAction="#handleNavigation" prefWidth="150.0" style="-fx-background-color: #008060; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="Calendar">
                    <graphic>
                        <Label style="-fx-font-size: 20px;" text="📅" textFill="WHITE" />
                    </graphic>
                </Button>

                <Button fx:id="notificationsButton" contentDisplay="LEFT" onAction="#handleNavigation" prefWidth="150.0" text="Chat"
                        style="-fx-background-color: #b0e0ff; -fx-background-radius: 5; -fx-font-weight: bold; -fx-border-color: #2090ff; -fx-text-fill: #0050c0; -fx-cursor: hand;">
                    <graphic>
                        <Label style="-fx-font-size: 20px;" text="🔔" textFill="#0050c0" />
                    </graphic>
                </Button>

            </VBox>

            <VBox VBox.vgrow="ALWAYS" />
            <Button fx:id="settingsButton" contentDisplay="LEFT" onAction="#handleNavigation" prefWidth="150.0" style="-fx-background-color: #008060; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="Settings">
                <graphic>
                    <Label style="-fx-font-size: 20px;" text="⚙" textFill="WHITE" />
                </graphic>
            </Button>

        </VBox>
    </left>

    <center>
        <SplitPane dividerPositions="0.4" style="-fx-border-color: transparent;">

            <VBox alignment="TOP_CENTER" spacing="15.0" style="-fx-background-color: #e6f0e6;">
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                </padding>

                <HBox alignment="CENTER_LEFT" prefHeight="40.0" style="-fx-background-color: WHITE; -fx-background-radius: 10; -fx-border-color: #c0d0c0; -fx-border-radius: 10; -fx-border-width: 2;">
                    <TextField promptText="Search Chats/Notifications" style="-fx-background-color: transparent; -fx-font-size: 14;" HBox.hgrow="ALWAYS">
                        <HBox.margin>
                            <Insets left="10.0" right="10.0" />
                        </HBox.margin>
                    </TextField>
                </HBox>

                <HBox alignment="CENTER" spacing="10.0">
                    <Button fx:id="filterAllButton" text="All" onAction="#handleFilterChange"
                            style="-fx-background-color: #008060; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" />

                    <Button fx:id="filterPatientsButton" text="Patients" onAction="#handleFilterChange"
                            style="-fx-background-color: #c0c0c0; -fx-text-fill: #202020; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" />

                    <Button fx:id="filterDoctorsButton" text="Doctors/Lab" onAction="#handleFilterChange"
                            style="-fx-background-color: #c0c0c0; -fx-text-fill: #202020; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" />
                </HBox>

                <Label text="Notifications" textFill="#202020">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="5.0" top="10.0" />
                    </VBox.margin>
                </Label>

                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                    <VBox fx:id="notificationsListVBox" spacing="10.0" style="-fx-background-color: transparent;">

                        <AnchorPane prefHeight="90.0" style="-fx-background-color: #d0fae0; -fx-background-radius: 10; -fx-border-color: #80c0a0; -fx-border-width: 1; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">
                            <padding>
                                <Insets bottom="10.0" left="0.0" right="10.0" top="10.0" />
                            </padding>

                            <VBox alignment="CENTER" prefWidth="120.0" spacing="2.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="15.0" AnchorPane.topAnchor="0.0">
                                <Label text="February" textFill="#808080">
                                    <font><Font size="12.0" /></font>
                                </Label>
                                <Label text="13" textFill="#202020">
                                    <font><Font name="System Bold" size="20.0" /></font>
                                </Label>
                                <Label text="2023" textFill="#808080">
                                    <font><Font size="12.0" /></font>
                                </Label>
                            </VBox>

                            <VBox alignment="CENTER_LEFT" spacing="5.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="145.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="10.0">

                                <HBox spacing="10.0">
                                    <Label style="-fx-font-weight: bold;" text="Patient Samira" textFill="#008060" />
                                </HBox>

                                <Label text="Doc puwede po pa resched po bukas....thnk u po...." textFill="#202020" wrapText="true">
                                    <font><Font size="14.0" /></font>
                                </Label>
                            </VBox>

                            <Button layoutX="0.0" layoutY="0.0" onAction="#handleNotificationClick" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"
                                    mnemonicParsing="false" style="-fx-background-color: transparent; -fx-cursor: hand;" />
                        </AnchorPane>

                        <Label text="... other chat items ..." />

                    </VBox>
                </ScrollPane>
            </VBox>

            <VBox fx:id="chatDetailVBox" alignment="TOP_CENTER" style="-fx-background-color: WHITE;">
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                </padding>

                <Label text="Chat with Patient Samira" textFill="#202020">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="10.0" top="10.0" />
                    </VBox.margin>
                </Label>
                <BorderPane style="-fx-border-color: #c0c0c0; -fx-border-width: 1; -fx-background-radius: 5;" VBox.vgrow="ALWAYS">
                    <center>
                        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;">
                            <VBox fx:id="messageContainerVBox" spacing="10.0" style="-fx-background-color: WHITE;">
                                <padding>
                                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                </padding>
                                <Label text="[System: Select a chat on the left to view the messages.]" textFill="#808080" wrapText="true" />
                            </VBox>
                        </ScrollPane>
                    </center>

                    <bottom>
                        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-border-color: #c0c0c0; -fx-border-width: 1 0 0 0; -fx-padding: 10 0 0 0;">
                            <TextField promptText="Type a message..." style="-fx-background-color: #f0f0f0; -fx-background-radius: 20; -fx-padding: 8 15 8 15;" HBox.hgrow="ALWAYS" />
                            <Button onAction="#handleSendMessage" style="-fx-background-color: #008060; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 20 8 20;" text="Send" />
                        </HBox>
                    </bottom>
                </BorderPane>
            </VBox>
        </SplitPane>
    </center>
</BorderPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="mainContainer"
            prefHeight="768.0"
            prefWidth="1366.0"
            style="-fx-background-color: #f5f5f5;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controller.Client.MedicalRecordCreateController">

    <!-- Sidebar -->
    <left>
        <VBox alignment="TOP_CENTER"
              prefWidth="60"
              spacing="15"
              style="-fx-background-color: #00BF63;">
            <padding>
                <Insets top="20" bottom="20"/>
            </padding>

            <ImageView fitHeight="40" fitWidth="40">
                <image>
                    <Image url="@../images/logoApp.png"/>
                </image>
            </ImageView>
        </VBox>
    </left>

    <!-- Main Content -->
    <center>
        <BorderPane style="-fx-background-color: white;">

            <!-- Header -->
            <top>
                <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 15;">
                    <Button text="Back"
                            onAction="#handleBack"
                            style="-fx-background-color: #77e374;
                                   -fx-text-fill: white;
                                   -fx-font-size: 16px;
                                   -fx-background-radius: 12;"/>

                    <Label text="Create Medical Record"
                           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                </HBox>
            </top>

            <!-- Form -->
            <center>
                <ScrollPane fitToWidth="true">
                    <VBox spacing="15" style="-fx-padding: 20;">

                        <!-- Patient Details -->
                        <Label text="Patient Details"
                               style="-fx-font-weight: bold;
                                      -fx-background-color: #e0e0e0;
                                      -fx-padding: 8;"/>

                        <GridPane hgap="10" vgap="10">
                            <ColumnConstraints percentWidth="33"/>
                            <ColumnConstraints percentWidth="33"/>
                            <ColumnConstraints percentWidth="33"/>

                            <TextField fx:id="patientIdField" promptText="Patient ID"/>
                            <TextField fx:id="patientNameField" promptText="Patient Name" GridPane.columnIndex="1"/>
                            <TextField fx:id="ageField" promptText="Age" GridPane.columnIndex="2"/>
                        </GridPane>

                        <!-- Subjective -->
                        <Label text="Subjective"/>
                        <TextArea fx:id="subjectiveArea"
                                  promptText="Patient's subjective complaints"
                                  wrapText="true"/>

                        <!-- Chief Complaint -->
                        <Label text="Chief Complaint"/>
                        <TextField fx:id="chiefComplaintField"
                                   promptText="Primary complaint"/>

                        <!-- HPI -->
                        <Label text="History of Present Illness"/>
                        <TextArea fx:id="hpiArea"
                                  promptText="Detailed history of present illness"
                                  wrapText="true"/>

                        <!-- OPQRST -->
                        <Label text="OPQRST"/>

                        <GridPane hgap="10" vgap="10">
                            <ColumnConstraints percentWidth="25"/>
                            <ColumnConstraints percentWidth="25"/>
                            <ColumnConstraints percentWidth="25"/>
                            <ColumnConstraints percentWidth="25"/>

                            <TextField fx:id="onsetField" promptText="Onset"/>
                            <TextField fx:id="locationField" promptText="Location" GridPane.columnIndex="1"/>
                            <TextField fx:id="durationField" promptText="Duration" GridPane.columnIndex="2"/>
                            <TextField fx:id="characterField" promptText="Character" GridPane.columnIndex="3"/>
                        </GridPane>

                        <GridPane hgap="10" vgap="10">
                            <ColumnConstraints percentWidth="34"/>
                            <ColumnConstraints percentWidth="33"/>
                            <ColumnConstraints percentWidth="33"/>

                            <TextArea fx:id="aggravatingArea"
                                      promptText="Aggravating / Relieving Factors"
                                      wrapText="true"/>

                            <TextField fx:id="radiationField"
                                       promptText="Radiation"
                                       GridPane.columnIndex="1"/>

                            <TextField fx:id="severityField"
                                       promptText="Severity (e.g. 4/10)"
                                       GridPane.columnIndex="2"/>
                        </GridPane>

                        <!-- PMI / Medications / Allergies -->
                        <GridPane hgap="10" vgap="10">
                            <ColumnConstraints percentWidth="33"/>
                            <ColumnConstraints percentWidth="34"/>
                            <ColumnConstraints percentWidth="33"/>

                            <TextArea fx:id="pmiArea" promptText="Past Medical Illness"/>
                            <TextArea fx:id="medicationArea" promptText="Current Medications" GridPane.columnIndex="1"/>
                            <TextArea fx:id="allergiesArea" promptText="Allergies" GridPane.columnIndex="2"/>
                        </GridPane>

                        <!-- FH / SH / ROS -->
                        <GridPane hgap="10" vgap="10">
                            <ColumnConstraints percentWidth="33"/>
                            <ColumnConstraints percentWidth="34"/>
                            <ColumnConstraints percentWidth="33"/>

                            <TextArea fx:id="fhArea" promptText="Family History"/>
                            <TextArea fx:id="shArea" promptText="Social History" GridPane.columnIndex="1"/>
                            <TextArea fx:id="rosArea" promptText="Review of Systems" GridPane.columnIndex="2"/>
                        </GridPane>

                        <!-- Actions -->
                        <HBox spacing="15" alignment="CENTER_RIGHT">
                            <Button text="Cancel"
                                    onAction="#handleCancel"/>

                            <Button text="Save Record"
                                    onAction="#handleSave"
                                    style="-fx-background-color: #00BF63;
                                           -fx-text-fill: white;
                                           -fx-font-size: 14px;
                                           -fx-background-radius: 12;"/>
                        </HBox>

                    </VBox>
                </ScrollPane>
            </center>

        </BorderPane>
    </center>
</BorderPane>

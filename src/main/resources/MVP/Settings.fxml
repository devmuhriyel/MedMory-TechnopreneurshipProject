      <Button layoutX="14.0" layoutY="129.0" prefWidth="180" style="-fx-background-color: #008060; -fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-background-radius: 10;" text="Home" />

      <!-- Accounts -->
      <Button fx:id="usersButton" layoutX="14.0" layoutY="184.0" onAction="#handleNavigation" prefWidth="180" style="                     -fx-background-color: #008060;                     -fx-text-fill: white;                     -fx-font-size: 18px;                     -fx-font-weight: bold;                     -fx-background-radius: 10;                 " text="👤   Accounts" />


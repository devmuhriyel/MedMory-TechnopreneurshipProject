<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.Doctor.Validation">
    <children>

        <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <VBox alignment="CENTER" maxHeight="554.0" maxWidth="618.0" prefHeight="551.0" prefWidth="500.0" spacing="30.0" style="-fx-background-color: white; -fx-background-radius: 15px; -fx-padding: 40px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.4), 20, 0, 0, 0);">
                    <children>
                        <VBox alignment="CENTER" spacing="10.0">
                            <children>
                                <Label text="Doctor Verification" textFill="#2196F3">
                                    <font>
                                        <Font name="System Bold" size="28.0" />
                                    </font>
                                </Label>
                                <Label text="Please verify your credentials to continue." textFill="#666666">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>

                        <VBox spacing="15.0">
                            <children>
                                <ComboBox fx:id="specializationCombo" prefHeight="51.0" prefWidth="349.0" promptText="Select Specialization" style="-fx-background-color: #f5f5f5; -fx-padding: 12px; -fx-border-color: #e0e0e0; -fx-border-radius: 5px; -fx-pref-height: 45px;" />
                                <TextField fx:id="licenseField" promptText="PRC License Number (7 Digits)" style="-fx-background-color: #f5f5f5; -fx-padding: 12px; -fx-border-color: #e0e0e0; -fx-border-radius: 5px;" />
                                <TextField fx:id="yearField" promptText="Year of Registration (YYYY)" style="-fx-background-color: #f5f5f5; -fx-padding: 12px; -fx-border-color: #e0e0e0; -fx-border-radius: 5px;" />
                                <TextArea fx:id="biographyArea" prefHeight="100.0" promptText="Brief professional biography (optional)" style="-fx-background-color: #f5f5f5; -fx-padding: 12px; -fx-border-color: #e0e0e0; -fx-border-radius: 5px;" wrapText="true" />
                            </children>
                        </VBox>

                        <HBox alignment="CENTER" spacing="25.0">
                            <children>
                                <Button fx:id="backButton" onAction="#handleBack" style="-fx-background-color: transparent; -fx-text-fill: #2c2c2c; -fx-font-weight: bold; -fx-font-size: 14px;" text="Cancel" />
                                <Button fx:id="completeRegistrationButton" onAction="#handleCompleteRegistration" prefHeight="45.0" prefWidth="200.0" style="-fx-background-color: #2c2c2c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-font-size: 14px;" text="Verify License" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </children>
</AnchorPane>

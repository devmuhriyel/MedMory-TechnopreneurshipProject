<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<BorderPane fx:id="mainContainer" prefHeight="768.0" prefWidth="1366.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.Doctor.HistoryController">

    <center>
        <VBox alignment="TOP_LEFT" spacing="15.0" style="-fx-background-color: #e6f0e6;" BorderPane.alignment="TOP_LEFT">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>

            <!-- Header -->
            <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Patient History" />

            <!-- Search Field -->
            <HBox alignment="CENTER_LEFT" spacing="10" />
            <TextField fx:id="searchField" promptText="Search treatment/diagnosis" />

            <!-- Cases Table -->
            <TableView fx:id="casesTable" prefHeight="300.0" prefWidth="1304.0">
                <columns>
                    <TableColumn fx:id="caseDateCol" prefWidth="186.0" text="Case Date" />
                    <TableColumn fx:id="treatmentCol" prefWidth="310.0" text="Treatment" />
                    <TableColumn fx:id="patientCol" prefWidth="163.0" text="Patient" />
                    <TableColumn fx:id="diagnosisCol" prefWidth="290.0" text="Diagnosis" />
                    <TableColumn fx:id="completionDateCol" prefWidth="376.0" text="Completion Date" />
                </columns>
            </TableView>

            <!-- Files Section -->
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Patient Files" />
            <TableView fx:id="filesTable" prefHeight="193.0" prefWidth="1082.0">
                <columns>
                    <TableColumn fx:id="fileNameCol" prefWidth="1325.0" text="File Name" />
                </columns>
            </TableView>

            <!-- Upload Button -->
            <Button fx:id="uploadButton" onAction="#handleUploadFile" text="Upload File" />

            <!-- Return Button -->
            <Button fx:id="returnButton" onAction="#handleReturn" prefWidth="120" text="Return" />
        </VBox>
    </center>
   <left>
       <VBox alignment="TOP_CENTER" prefWidth="170.0" spacing="15.0" style="-fx-background-color: #00BF63;" BorderPane.alignment="TOP_LEFT">
           <padding>
               <Insets bottom="20.0" left="10.0" right="10.0" top="20.0" />
           </padding>
           <ImageView fitHeight="45.0" fitWidth="45.0">
               <image>
                   <Image url="@../images/logoApp.png" />
               </image>
           </ImageView>

           <VBox alignment="CENTER" spacing="10.0">
               <Button fx:id="accountButton" contentDisplay="LEFT" onAction="#handleNavigation" prefWidth="150.0" style="-fx-background-color: #008060; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="Account">
                   <graphic>
                       <Label style="-fx-font-size: 20px;" text="👤" textFill="WHITE" />
                   </graphic>
               </Button>
               <Button fx:id="casesButton" contentDisplay="LEFT" onAction="#handleNavigation" prefWidth="150.0" style="-fx-background-color: #b0e0ff; -fx-background-radius: 5; -fx-font-weight: bold; -fx-border-color: #2090ff; -fx-text-fill: #0050c0; -fx-cursor: hand;" text="Patients">
                   <graphic>
                       <Label style="-fx-font-size: 20px;" text="👤" textFill="#0050c0" />
                   </graphic>
               </Button>
               <Button fx:id="calendarButton" contentDisplay="LEFT" onAction="#handleNavigation" prefWidth="150.0" style="-fx-background-color: #008060; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="Calendar">
                   <graphic>
                       <Label style="-fx-font-size: 20px;" text="📅" textFill="WHITE" />
                   </graphic>
               </Button>
               <Button fx:id="notificationsButton" contentDisplay="LEFT" onAction="#handleNavigation" prefWidth="150.0" style="-fx-background-color: #008060; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="Chat">
                   <graphic>
                       <Label style="-fx-font-size: 20px;" text="💬" textFill="WHITE" />
                   </graphic>
               </Button>
           </VBox>

           <VBox VBox.vgrow="ALWAYS" />
           <Button fx:id="settingsButton" contentDisplay="LEFT" onAction="#handleNavigation" prefWidth="150.0" style="-fx-background-color: #008060; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="Settings">
               <graphic>
                   <Label style="-fx-font-size: 20px;" text="⚙" textFill="WHITE" />
               </graphic>
           </Button>

       </VBox>
   </left>
</BorderPane>

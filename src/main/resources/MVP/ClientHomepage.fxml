<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="mainContainer" prefHeight="768.0" prefWidth="1366.0" style="-fx-background-color: #e6f0e6;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.Client.ClientHomepageController">

    <left>
        <VBox alignment="TOP_CENTER" prefWidth="170.0" spacing="15.0" style="-fx-background-color: #00BF63;" BorderPane.alignment="TOP_LEFT">
            <padding>
                <Insets bottom="20.0" left="10.0" right="10.0" top="20.0" />
            </padding>
            <ImageView fitHeight="45.0" fitWidth="45.0">
                <image>
                    <Image url="@../images/logoApp.png" />
                </image>
            </ImageView>

            <VBox alignment="CENTER" spacing="10.0">
                <Button fx:id="homeButton" contentDisplay="LEFT" onAction="#handleNavigation" prefWidth="150.0" style="-fx-background-color: #b0e0ff; -fx-background-radius: 5; -fx-font-weight: bold; -fx-border-color: #2090ff; -fx-text-fill: #0050c0; -fx-cursor: hand;" text="Home">
                    <graphic>
                        <Label style="-fx-font-size: 20px;" text="🏠" textFill="#0050c0" />
                    </graphic>
                </Button>

                <Button fx:id="accountButton" contentDisplay="LEFT" onAction="#handleNavigation" prefWidth="150.0" style="-fx-background-color: #008060; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="Account">
                    <graphic>
                        <Label style="-fx-font-size: 20px;" text="👤" textFill="WHITE" />
                    </graphic>
                </Button>

                <Button fx:id="medicalRecordButton" contentDisplay="LEFT" onAction="#handleNavigation" prefWidth="150.0" style="-fx-background-color: #008060; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="Medical Record">
                    <graphic>
                        <Label style="-fx-font-size: 20px;" text="💼" textFill="WHITE" />
                    </graphic>
                </Button>

                <Button fx:id="calendarButton" contentDisplay="LEFT" onAction="#handleNavigation" prefWidth="150.0" style="-fx-background-color: #008060; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="Calendar">
                    <graphic>
                        <Label style="-fx-font-size: 20px;" text="📅" textFill="WHITE" />
                    </graphic>
                </Button>

                <Button fx:id="chatsButton" contentDisplay="LEFT" onAction="#handleNavigation" prefWidth="150.0" style="-fx-background-color: #008060; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="Chat">
                    <graphic>
                        <Label style="-fx-font-size: 20px;" text="💬" textFill="WHITE" />
                    </graphic>
                </Button>
            </VBox>

            <VBox VBox.vgrow="ALWAYS" />

            <Button fx:id="settingsButton" contentDisplay="LEFT" onAction="#handleNavigation" prefWidth="150.0" style="-fx-background-color: #008060; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="Settings">
                <graphic>
                    <Label style="-fx-font-size: 20px;" text="⚙" textFill="WHITE" />
                </graphic>
            </Button>
        </VBox>
    </left>

    <center>
        <VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #e6f0e6;">
            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
            </padding>

            <VBox alignment="CENTER" maxWidth="1111.0" prefHeight="702.0" prefWidth="1111.0" spacing="20.0" style="-fx-background-color: WHITE; -fx-background-radius: 15; -fx-padding: 60;">
                <ImageView fitHeight="286.0" fitWidth="312.0" preserveRatio="true">
                    <image>
                        <Image url="@../images/bigLogo.png" />
                    </image>
                </ImageView>

                <Label text="Your history in one place." textAlignment="CENTER" textFill="#333333">
                    <font>
                        <Font name="System" size="24.0" />
                    </font>
                </Label>
            </VBox>
        </VBox>
    </center>
</BorderPane>